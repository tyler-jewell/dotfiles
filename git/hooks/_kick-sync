#!/usr/bin/env bash
# Sourced by post-* hooks. Starts `git-sync --hook --quiet` detached, at most
# once per 5 minutes per repo. Everything here must be fast and fail silent.
_kick_sync() {
  [ -n "${DOTFILES_GIT_SYNC_RUNNING:-}" ] && return 0 # we are inside git-sync itself
  [ "${GIT_SYNC_DISABLE:-}" = 1 ] && return 0
  dot_feature sync || return 0
  dot_is_exempt && return 0
  local common stamp gs
  common=$(dot_common_dir) || return 0
  stamp="$common/git-sync.kick"
  if [ -e "$stamp" ] && [ -n "$(find "$stamp" -mmin -5 2>/dev/null)" ]; then return 0; fi
  gs=$(command -v git-sync 2>/dev/null)
  [ -n "$gs" ] || gs="$HERE/../../bin/git-sync"
  [ -x "$gs" ] || return 0
  : >"$stamp" 2>/dev/null || return 0
  (cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" 2>/dev/null &&
    nohup "$gs" --hook --quiet </dev/null >/dev/null 2>&1 &) >/dev/null 2>&1
  return 0
}
_kick_sync
